                  },
                  "displayName": {
                    "type": "string",
                    "example": "Editor"
                  },
                  "description": {
                    "type": "string"
                  },
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "category:read",
                      "category:create"
                    ]
                  }
                }
